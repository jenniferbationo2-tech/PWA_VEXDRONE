# URL de base de l'API backend (FastAPI).
# Laisse vide ou omet la variable pour utiliser des chemins relatifs (proxy/same-origin).
VITE_API_BASE_URL=http://localhost:8000

# "true" pour utiliser les mocks frontend (aucun backend requis) au lieu des
# vrais appels API. Toute autre valeur (ou absence de variable) désactive les mocks.
VITE_USE_MOCKS=false

# DSN Sentry (suivi d'erreurs). Laisse vide pour désactiver — le suivi ne
# s'active de toute façon qu'en build de prod (voir src/lib/monitoring/sentry.ts),
# jamais en dev local.
VITE_SENTRY_DSN=
